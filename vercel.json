{
  "env": {
    "NODE_ENV": "production"
  },
  "installCommand": "npm install",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next",
      "config": { "outputDirectory": "dist/frontend" }
    },
    {
      "src": "api/package.json",
      "use": "@vercel/node",
      "config": { "includeFiles": ["api/**"] },
      "buildCommand": "npm run build --workspace=api"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/dist/main.js"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}