{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next",
      "env": { "NEXT_PUBLIC_VERCEL_ENV": "production" }
    },
    {
      "src": "api/main.ts",
      "use": "@vercel/node",
      "config": { "includeFiles": ["api/**"] }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/main.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}